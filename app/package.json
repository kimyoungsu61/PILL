{
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "npm run test:runner && npm run typecheck && npm run test:contracts",
    "test:runner": "node --test scripts/run-contracts.test.mjs scripts/ritual-primitives.test.mjs",
    "typecheck": "node --stack_size=8192 node_modules/typescript/bin/tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:contracts": "node scripts/run-contracts.mjs",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:web": "expo export --platform web --output-dir dist/web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "7.3.4",
    "@react-navigation/native-stack": "7.17.6",
    "expo": "~57.0.8",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-notifications": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "expo-doctor": "1.20.0",
    "tsx": "4.23.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
